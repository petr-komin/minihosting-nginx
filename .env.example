# Hostingy - konfigurace prostředí

# Port na kterém běží aplikace
PORT=3000

# JWT secret - ZMĚŇTE V PRODUKCI!
JWT_SECRET=zmenit-na-nahodny-retezec-v-produkci

# Cesta k SQLite databázi
# DB_PATH=/var/lib/hostingy/hostingy.db

# Nginx cesty
# NGINX_CONFIG_PATH=/etc/nginx
# NGINX_SITES_AVAILABLE=/etc/nginx/sites-available
# NGINX_SITES_ENABLED=/etc/nginx/sites-enabled
# NGINX_BINARY=/usr/sbin/nginx

# Certbot
# CERTBOT_BINARY=/usr/bin/certbot
# CERTBOT_WEBROOT=/var/www/certbot

# Prostředí
NODE_ENV=production
